{
  "name": "playwright-cucumber-ts",
  "version": "1.0.0",
  "description": "Playwright Cucumber TypeScript Framework",
  "scripts": {
    "test": "cucumber-js",
    "test:chrome": "cucumber-js --profile chrome",
    "test:firefox": "cucumber-js --profile firefox",
    "test:webkit": "cucumber-js --profile webkit",
    "test:msedge": "cucumber-js --profile msedge",
    "report:generate": "node utils/report-generator.js",
    "allure:generate": "node utils/allure-cli.js generate reports/allure-results --clean -o allure-report",
    "allure:open": "node utils/allure-cli.js open allure-report"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.3",
    "exceljs": "^4.3.0",
    "fs-extra": "^11.1.0",
    "multiple-cucumber-html-reporter": "^3.4.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@playwright/test": "^1.56.1",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^18.13.0",
    "allure-commandline": "^2.38.0",
    "allure-cucumberjs": "^2.15.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
